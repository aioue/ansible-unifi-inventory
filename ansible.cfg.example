# Installed collections are discovered by FQCN; enable_plugins is unnecessary.
# Install a locally built collection for development instead of pointing
# inventory_plugins at a source checkout.

[defaults]
inventory = ./inventory/unifi.yaml

[inventory]
# Standard inventory caching replaces the former cache_ttl/cache_path options.
# This cache contains network metadata; keep the directory private.
cache = true
cache_plugin = ansible.builtin.jsonfile
cache_timeout = 30
cache_connection = .cache/unifi_inventory
