# Export these variables in your shell, or load a private .env explicitly.
# The plugin does not read .env files automatically.

# Controller base URL and site
UNIFI_URL=https://unifi.example.net
UNIFI_SITE=default

# Local password authentication. Leave credentials out of inventory YAML
# when you want Ansible to use environment values.
UNIFI_USERNAME=ansible-inventory
UNIFI_PASSWORD=
# Optional Base32 shared secret for accounts requiring TOTP, not a 6-digit code.
UNIFI_TOTP_SECRET=

# Optional alternative: an existing UniFi OS TOKEN session cookie.
# It takes precedence over password login, expires, and cannot renew itself.
# Network API integration keys are unsupported; do not put them here.
UNIFI_TOKEN=

# Trust the controller CA; false accepts an unverified TLS connection.
UNIFI_VALIDATE_CERTS=true

# Clients are included by default; infrastructure is opt-in.
UNIFI_INCLUDE_DEVICES=false
UNIFI_EXCLUDE_CLIENTS=false
UNIFI_EXCLUDE_DEVICES=false

# Excludes stale/disconnected clients beyond this recency threshold (minutes).
UNIFI_LAST_SEEN_MINUTES=30

# MAC-based names stay stable when friendly names change.
UNIFI_HOSTNAME=name

# Duplicate names are renamed with a MAC suffix and a warning, or fail.
UNIFI_HOSTNAME_COLLISION=disambiguate

# Caching uses Ansible's cache/cache_plugin/cache_timeout/cache_connection
# inventory options, not UNIFI_CACHE_TTL or UNIFI_CACHE_PATH.
